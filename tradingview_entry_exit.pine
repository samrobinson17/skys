//@version=5
// ═══════════════════════════════════════════════════════════════════
//  INTRADAY SCALP / SWING INDICATOR  |  Pine Script v5
//  Optimised for: 1m · 3m · 5m · 15m charts
//  Goal: In & out within the hour — clear ENTER / TP signals
// ═══════════════════════════════════════════════════════════════════
indicator("Intraday Scalp & Swing Signals", overlay=true, max_labels_count=500, max_lines_count=500)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grpEMA   = "═══ EMA Settings ═══"
grpTP    = "═══ TP / SL Settings ═══"
grpFilt  = "═══ Filters ═══"
grpSess  = "═══ Session (your timezone) ═══"
grpDisp  = "═══ Display ═══"

// Fast EMAs suited for intraday
ema5Len  = input.int(5,  "EMA 5  (micro)",  group=grpEMA, minval=1)
ema9Len  = input.int(9,  "EMA 9  (fast)",   group=grpEMA, minval=1)
ema21Len = input.int(21, "EMA 21 (slow)",   group=grpEMA, minval=1)
ema50Len = input.int(50, "EMA 50 (trend)",  group=grpEMA, minval=1)

// RSI — shorter for scalping
rsiLen   = input.int(7,  "RSI Length",     group=grpFilt, minval=1)
rsiOB    = input.int(70, "RSI Overbought", group=grpFilt, minval=55, maxval=90)
rsiOS    = input.int(30, "RSI Oversold",   group=grpFilt, minval=10, maxval=45)

// Stochastic
stochK   = input.int(5,  "Stoch %K", group=grpFilt, minval=1)
stochD   = input.int(3,  "Stoch %D", group=grpFilt, minval=1)
stochSm  = input.int(3,  "Smooth",   group=grpFilt, minval=1)

// MACD — fast settings
macdF    = input.int(8,  "MACD Fast",   group=grpFilt, minval=1)
macdSl   = input.int(17, "MACD Slow",   group=grpFilt, minval=1)
macdSig  = input.int(9,  "MACD Signal", group=grpFilt, minval=1)

// ATR / TP / SL — tight for intraday
atrLen   = input.int(7,   "ATR Length",         group=grpTP, minval=1)
slMult   = input.float(0.8,"SL ATR Multiplier", group=grpTP, minval=0.2, step=0.1)
tp1Mult  = input.float(1.0,"TP1 ATR Multiplier",group=grpTP, minval=0.3, step=0.1)
tp2Mult  = input.float(2.0,"TP2 ATR Multiplier",group=grpTP, minval=0.5, step=0.1)
tp3Mult  = input.float(3.5,"TP3 ATR Multiplier",group=grpTP, minval=1.0, step=0.1)

// Min confluence to fire
minConf  = input.int(3, "Min Confluence Score (1-6)", group=grpFilt, minval=1, maxval=6)

// Volume
volFilt  = input.bool(true,  "Require Above-Avg Volume", group=grpFilt)
volMult  = input.float(1.1,  "Volume Multiplier",        group=grpFilt, step=0.1)

// Session gate — only trade during active hours
useSess  = input.bool(true,  "Limit to Trading Session", group=grpSess)
sessStr  = input.session("0700-2000", "Session (exchange time)", group=grpSess)

// Display
showEMAs = input.bool(true,  "Show EMAs",          group=grpDisp)
showVWAP = input.bool(true,  "Show VWAP",          group=grpDisp)
showTP   = input.bool(true,  "Show TP/SL Lines",   group=grpDisp)
showLbl  = input.bool(true,  "Show Entry Labels",  group=grpDisp)
showTbl  = input.bool(true,  "Show Score Table",   group=grpDisp)

// ─────────────────────────────────────────────
// SESSION FILTER
// ─────────────────────────────────────────────
inSession = not useSess or time(timeframe.period, sessStr) != 0

// ─────────────────────────────────────────────
// EMAs
// ─────────────────────────────────────────────
ema5  = ta.ema(close, ema5Len)
ema9  = ta.ema(close, ema9Len)
ema21 = ta.ema(close, ema21Len)
ema50 = ta.ema(close, ema50Len)

// ─────────────────────────────────────────────
// VWAP  (resets each day — key intraday level)
// ─────────────────────────────────────────────
vwap = ta.vwap(hlc3)

// ─────────────────────────────────────────────
// RSI
// ─────────────────────────────────────────────
rsi = ta.rsi(close, rsiLen)

// ─────────────────────────────────────────────
// MACD
// ─────────────────────────────────────────────
[macdLine, sigLine, macdHist] = ta.macd(close, macdF, macdSl, macdSig)
macdBull = ta.crossover(macdLine, sigLine)
macdBear = ta.crossunder(macdLine, sigLine)

// ─────────────────────────────────────────────
// STOCHASTIC
// ─────────────────────────────────────────────
stK = ta.sma(ta.stoch(close, high, low, stochK), stochSm)
stD = ta.sma(stK, stochD)

// ─────────────────────────────────────────────
// ATR & VOLUME
// ─────────────────────────────────────────────
atr    = ta.atr(atrLen)
volSMA = ta.sma(volume, 20)
volOk  = volFilt ? volume > volSMA * volMult : true

// ─────────────────────────────────────────────
// CANDLESTICK PATTERNS  (fast, 1–2 bar)
// ─────────────────────────────────────────────
body      = math.abs(close - open)
candle    = high - low
upWick    = high - math.max(close, open)
dnWick    = math.min(close, open) - low
isBull    = close > open
isBear    = close < open

bullEngulf = isBear[1] and isBull and open <= close[1] and close >= open[1] and body > body[1]
bearEngulf = isBull[1] and isBear and open >= close[1] and close <= open[1] and body > body[1]
hammer     = dnWick >= body * 2.0 and upWick <= body * 0.5 and body > atr * 0.15
shootStar  = upWick >= body * 2.0 and dnWick <= body * 0.5 and body > atr * 0.15
bullPin    = dnWick >= candle * 0.55 and body < candle * 0.35
bearPin    = upWick >= candle * 0.55 and body < candle * 0.35

bullPattern = bullEngulf or hammer or bullPin
bearPattern = bearEngulf or shootStar or bearPin

// ─────────────────────────────────────────────
// MOMENTUM BURST  (strong candle in trend direction)
// ─────────────────────────────────────────────
bullMomentum = isBull and body > atr * 0.7 and close > ema9
bearMomentum = isBear and body > atr * 0.7 and close < ema9

// ─────────────────────────────────────────────
// CONFLUENCE SCORING (0–6 per direction)
// ─────────────────────────────────────────────

// LONG — 6 layers
longS1 = (ema5 > ema9 and ema9 > ema21 and close > ema21) ? 1 : 0    // EMA stack
longS2 = (close > vwap) ? 1 : 0                                        // Above VWAP
longS3 = (rsi > 45 and rsi < rsiOB) ? 1 : 0                           // RSI range
longS4 = (macdLine > sigLine or macdBull) ? 1 : 0                      // MACD
longS5 = (stK > stD and stK < 80) ? 1 : 0                              // Stoch
longS6 = (bullPattern or bullMomentum) ? 1 : 0                         // Pattern/momentum
longScore = longS1 + longS2 + longS3 + longS4 + longS5 + longS6

// SHORT — 6 layers
shortS1 = (ema5 < ema9 and ema9 < ema21 and close < ema21) ? 1 : 0
shortS2 = (close < vwap) ? 1 : 0
shortS3 = (rsi < 55 and rsi > rsiOS) ? 1 : 0
shortS4 = (macdLine < sigLine or macdBear) ? 1 : 0
shortS5 = (stK < stD and stK > 20) ? 1 : 0
shortS6 = (bearPattern or bearMomentum) ? 1 : 0
shortScore = shortS1 + shortS2 + shortS3 + shortS4 + shortS5 + shortS6

// ─────────────────────────────────────────────
// SIGNAL — fire on first bar that hits threshold
// ─────────────────────────────────────────────
longSignal  = longScore  >= minConf and volOk and inSession
             and not (longScore[1]  >= minConf and volOk[1])
shortSignal = shortScore >= minConf and volOk and inSession
             and not (shortScore[1] >= minConf and volOk[1])

// ─────────────────────────────────────────────
// TP / SL
// ─────────────────────────────────────────────
var float lSL  = na
var float lTP1 = na
var float lTP2 = na
var float lTP3 = na
var float sSL  = na
var float sTP1 = na
var float sTP2 = na
var float sTP3 = na

if longSignal
    lSL  := close - atr * slMult
    lTP1 := close + atr * tp1Mult
    lTP2 := close + atr * tp2Mult
    lTP3 := close + atr * tp3Mult

if shortSignal
    sSL  := close + atr * slMult
    sTP1 := close - atr * tp1Mult
    sTP2 := close - atr * tp2Mult
    sTP3 := close - atr * tp3Mult

// ─────────────────────────────────────────────
// SCORE COLOUR HELPER  (green → red by strength)
// ─────────────────────────────────────────────
scoreColor(s, maxS) =>
    pct = s / maxS
    pct >= 0.83 ? color.new(#00ff00, 0) :
     pct >= 0.67 ? color.new(#66ff00, 0) :
     pct >= 0.5  ? color.new(#ffcc00, 0) :
     color.new(color.gray, 40)

// ─────────────────────────────────────────────
// PLOTS — EMAs
// ─────────────────────────────────────────────
plot(showEMAs ? ema5  : na, "EMA 5",  color=color.new(color.aqua,   0), linewidth=1)
plot(showEMAs ? ema9  : na, "EMA 9",  color=color.new(color.yellow, 0), linewidth=1)
plot(showEMAs ? ema21 : na, "EMA 21", color=color.new(color.orange, 0), linewidth=2)
plot(showEMAs ? ema50 : na, "EMA 50", color=color.new(color.gray,  30), linewidth=2)

// VWAP
plot(showVWAP ? vwap : na, "VWAP", color=color.new(color.purple, 0), linewidth=2, style=plot.style_line)

// ─────────────────────────────────────────────
// SIGNAL ARROWS
// ─────────────────────────────────────────────
plotshape(longSignal,
 title="LONG", style=shape.triangleup, location=location.belowbar,
 color=scoreColor(longScore, 6), size=size.large, text="▲ ENTER")

plotshape(shortSignal,
 title="SHORT", style=shape.triangledown, location=location.abovebar,
 color=scoreColor(shortScore, 6), size=size.large, text="▼ ENTER")

bgcolor(longSignal  ? color.new(color.lime, 82) : na)
bgcolor(shortSignal ? color.new(color.red,  82) : na)

// ─────────────────────────────────────────────
// TP / SL LINES
// ─────────────────────────────────────────────
ext = 30

if showTP and longSignal
    line.new(bar_index, lSL,  bar_index + ext, lSL,  color=color.new(color.red,   0), width=1, style=line.style_dotted)
    line.new(bar_index, lTP1, bar_index + ext, lTP1, color=color.new(color.lime,  50), width=1, style=line.style_dashed)
    line.new(bar_index, lTP2, bar_index + ext, lTP2, color=color.new(color.lime,  20), width=2, style=line.style_dashed)
    line.new(bar_index, lTP3, bar_index + ext, lTP3, color=color.new(color.lime,   0), width=2, style=line.style_solid)

if showTP and shortSignal
    line.new(bar_index, sSL,  bar_index + ext, sSL,  color=color.new(color.red,    0), width=1, style=line.style_dotted)
    line.new(bar_index, sTP1, bar_index + ext, sTP1, color=color.new(color.orange, 50), width=1, style=line.style_dashed)
    line.new(bar_index, sTP2, bar_index + ext, sTP2, color=color.new(color.orange, 20), width=2, style=line.style_dashed)
    line.new(bar_index, sTP3, bar_index + ext, sTP3, color=color.new(color.orange,  0), width=2, style=line.style_solid)

// ─────────────────────────────────────────────
// ENTRY LABELS  — show levels immediately
// ─────────────────────────────────────────────
rr(tp, sl, entry) =>
    math.round(math.abs(tp - entry) / math.abs(entry - sl), 1)

if showLbl and longSignal
    label.new(bar_index, low - atr * 0.6,
     "▲ LONG  [" + str.tostring(longScore) + "/6]\n" +
     "ENTRY: " + str.tostring(math.round(close,  4)) + "\n" +
     "TP1:   " + str.tostring(math.round(lTP1,   4)) + "  (R:R " + str.tostring(rr(lTP1, lSL, close)) + ")\n" +
     "TP2:   " + str.tostring(math.round(lTP2,   4)) + "  (R:R " + str.tostring(rr(lTP2, lSL, close)) + ")\n" +
     "TP3:   " + str.tostring(math.round(lTP3,   4)) + "  (R:R " + str.tostring(rr(lTP3, lSL, close)) + ")\n" +
     "SL:    " + str.tostring(math.round(lSL,    4)),
     style=label.style_label_up,
     color=color.new(#003300, 10), textcolor=color.new(color.lime, 0), size=size.normal)

if showLbl and shortSignal
    label.new(bar_index, high + atr * 0.6,
     "▼ SHORT  [" + str.tostring(shortScore) + "/6]\n" +
     "ENTRY: " + str.tostring(math.round(close,  4)) + "\n" +
     "TP1:   " + str.tostring(math.round(sTP1,   4)) + "  (R:R " + str.tostring(rr(sTP1, sSL, close)) + ")\n" +
     "TP2:   " + str.tostring(math.round(sTP2,   4)) + "  (R:R " + str.tostring(rr(sTP2, sSL, close)) + ")\n" +
     "TP3:   " + str.tostring(math.round(sTP3,   4)) + "  (R:R " + str.tostring(rr(sTP3, sSL, close)) + ")\n" +
     "SL:    " + str.tostring(math.round(sSL,    4)),
     style=label.style_label_down,
     color=color.new(#330000, 10), textcolor=color.new(color.red, 0), size=size.normal)

// ─────────────────────────────────────────────
// LIVE SCORE TABLE  (top-right, updates every bar)
// ─────────────────────────────────────────────
check(v) => v ? "✔" : "—"
cc(v)    => v ? color.new(color.lime, 20) : color.new(color.gray, 60)

var table t = table.new(position.top_right, 3, 10,
 bgcolor=color.new(color.black, 50),
 border_color=color.new(color.gray, 50), border_width=1,
 frame_color=color.new(color.gray, 30), frame_width=1)

if barstate.islast and showTbl
    table.cell(t, 0, 0, "SIGNAL LAYER",  text_color=color.white,       text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
    table.cell(t, 1, 0, "▲ LONG",        text_color=color.lime,         text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
    table.cell(t, 2, 0, "▼ SHORT",       text_color=color.red,          text_size=size.small, bgcolor=color.new(#1a1a2e, 0))

    table.cell(t, 0, 1, "EMA Stack",     text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 1, check(longS1==1),  text_color=cc(longS1==1),  text_size=size.tiny)
    table.cell(t, 2, 1, check(shortS1==1), text_color=cc(shortS1==1), text_size=size.tiny)

    table.cell(t, 0, 2, "Above VWAP",    text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 2, check(longS2==1),  text_color=cc(longS2==1),  text_size=size.tiny)
    table.cell(t, 2, 2, check(shortS2==1), text_color=cc(shortS2==1), text_size=size.tiny)

    table.cell(t, 0, 3, "RSI (" + str.tostring(math.round(rsi,1)) + ")", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 3, check(longS3==1),  text_color=cc(longS3==1),  text_size=size.tiny)
    table.cell(t, 2, 3, check(shortS3==1), text_color=cc(shortS3==1), text_size=size.tiny)

    table.cell(t, 0, 4, "MACD",          text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 4, check(longS4==1),  text_color=cc(longS4==1),  text_size=size.tiny)
    table.cell(t, 2, 4, check(shortS4==1), text_color=cc(shortS4==1), text_size=size.tiny)

    table.cell(t, 0, 5, "Stochastic",    text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 5, check(longS5==1),  text_color=cc(longS5==1),  text_size=size.tiny)
    table.cell(t, 2, 5, check(shortS5==1), text_color=cc(shortS5==1), text_size=size.tiny)

    table.cell(t, 0, 6, "Pattern/Burst", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 6, check(longS6==1),  text_color=cc(longS6==1),  text_size=size.tiny)
    table.cell(t, 2, 6, check(shortS6==1), text_color=cc(shortS6==1), text_size=size.tiny)

    table.cell(t, 0, 7, "Volume",        text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 7, check(volOk),     text_color=cc(volOk),  text_size=size.tiny)
    table.cell(t, 2, 7, check(volOk),     text_color=cc(volOk),  text_size=size.tiny)

    table.cell(t, 0, 8, "In Session",    text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 8, check(inSession), text_color=cc(inSession), text_size=size.tiny)
    table.cell(t, 2, 8, check(inSession), text_color=cc(inSession), text_size=size.tiny)

    lCol  = longScore  >= minConf ? color.lime : color.gray
    sCol  = shortScore >= minConf ? color.red  : color.gray
    table.cell(t, 0, 9, "SCORE / 6",    text_color=color.white, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
    table.cell(t, 1, 9, str.tostring(longScore)  + " / 6", text_color=lCol, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))
    table.cell(t, 2, 9, str.tostring(shortScore) + " / 6", text_color=sCol, text_size=size.small, bgcolor=color.new(#1a1a2e, 0))

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────
alertcondition(longSignal,  "▲ LONG Entry",  "LONG entry on {{ticker}} ({{interval}}). Check TP/SL on chart.")
alertcondition(shortSignal, "▼ SHORT Entry", "SHORT entry on {{ticker}} ({{interval}}). Check TP/SL on chart.")
