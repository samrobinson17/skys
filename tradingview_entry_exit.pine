//@version=5
// ═══════════════════════════════════════════════════════════════════
//  INTRADAY SCALP / SWING INDICATOR  |  Pine Script v5
//  Clean chart — all signal info in the side panel
//  Optimised for: 1m · 3m · 5m · 15m charts
// ═══════════════════════════════════════════════════════════════════
indicator("Intraday Signal Panel", overlay=true, max_labels_count=100, max_lines_count=200)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grpEMA  = "═══ EMA Settings ═══"
grpTP   = "═══ TP / SL Settings ═══"
grpFilt = "═══ Filters ═══"
grpSess = "═══ Session (exchange time) ═══"
grpDisp = "═══ Display ═══"

ema5Len  = input.int(5,  "EMA 5",  group=grpEMA, minval=1)
ema9Len  = input.int(9,  "EMA 9",  group=grpEMA, minval=1)
ema21Len = input.int(21, "EMA 21", group=grpEMA, minval=1)
ema50Len = input.int(50, "EMA 50", group=grpEMA, minval=1)

rsiLen  = input.int(7,  "RSI Length",     group=grpFilt, minval=1)
rsiOB   = input.int(70, "RSI Overbought", group=grpFilt, minval=55, maxval=90)
rsiOS   = input.int(30, "RSI Oversold",   group=grpFilt, minval=10, maxval=45)

stochK  = input.int(5, "Stoch %K", group=grpFilt, minval=1)
stochD  = input.int(3, "Stoch %D", group=grpFilt, minval=1)
stochSm = input.int(3, "Smooth",   group=grpFilt, minval=1)

macdF   = input.int(8,  "MACD Fast",   group=grpFilt, minval=1)
macdSl  = input.int(17, "MACD Slow",   group=grpFilt, minval=1)
macdSig = input.int(9,  "MACD Signal", group=grpFilt, minval=1)

atrLen  = input.int(7,    "ATR Length",         group=grpTP, minval=1)
slMult  = input.float(0.8,"SL ATR Multiplier",  group=grpTP, minval=0.2, step=0.1)
tp1Mult = input.float(1.0,"TP1 ATR Multiplier", group=grpTP, minval=0.3, step=0.1)
tp2Mult = input.float(2.0,"TP2 ATR Multiplier", group=grpTP, minval=0.5, step=0.1)
tp3Mult = input.float(3.5,"TP3 ATR Multiplier", group=grpTP, minval=1.0, step=0.1)

minConf = input.int(3,   "Min Score to Signal (1-6)", group=grpFilt, minval=1, maxval=6)
volFilt = input.bool(true,"Require Above-Avg Volume", group=grpFilt)
volMult = input.float(1.1,"Volume Multiplier",        group=grpFilt, step=0.1)

useSess = input.bool(true,         "Limit to Session",      group=grpSess)
sessStr = input.session("0700-2000","Session (exch. time)", group=grpSess)

showEMAs = input.bool(true, "Show EMAs",       group=grpDisp)
showVWAP = input.bool(true, "Show VWAP",       group=grpDisp)
showTP   = input.bool(true, "Show TP/SL Lines",group=grpDisp)
showDots = input.bool(true, "Show Signal Dots (small)", group=grpDisp)

// ─────────────────────────────────────────────
// CORE CALCS
// ─────────────────────────────────────────────
inSession = not useSess or time(timeframe.period, sessStr) != 0

ema5  = ta.ema(close, ema5Len)
ema9  = ta.ema(close, ema9Len)
ema21 = ta.ema(close, ema21Len)
ema50 = ta.ema(close, ema50Len)
vwap  = ta.vwap(hlc3)
rsi   = ta.rsi(close, rsiLen)

[macdLine, sigLine, _] = ta.macd(close, macdF, macdSl, macdSig)
macdBull = ta.crossover(macdLine, sigLine)
macdBear = ta.crossunder(macdLine, sigLine)

stK = ta.sma(ta.stoch(close, high, low, stochK), stochSm)
stD = ta.sma(stK, stochD)

atr    = ta.atr(atrLen)
volSMA = ta.sma(volume, 20)
volOk  = volFilt ? volume > volSMA * volMult : true

// ─────────────────────────────────────────────
// CANDLESTICK PATTERNS
// ─────────────────────────────────────────────
body   = math.abs(close - open)
candle = high - low
upWick = high - math.max(close, open)
dnWick = math.min(close, open) - low
isBull = close > open
isBear = close < open

bullEngulf = isBear[1] and isBull and open <= close[1] and close >= open[1] and body > body[1]
bearEngulf = isBull[1] and isBear and open >= close[1] and close <= open[1] and body > body[1]
hammer     = dnWick >= body * 2.0 and upWick <= body * 0.5 and body > atr * 0.15
shootStar  = upWick >= body * 2.0 and dnWick <= body * 0.5 and body > atr * 0.15
bullPin    = dnWick >= candle * 0.55 and body < candle * 0.35
bearPin    = upWick >= candle * 0.55 and body < candle * 0.35

bullMomentum = isBull and body > atr * 0.7 and close > ema9
bearMomentum = isBear and body > atr * 0.7 and close < ema9

bullPattern = bullEngulf or hammer or bullPin or bullMomentum
bearPattern = bearEngulf or shootStar or bearPin or bearMomentum

// ─────────────────────────────────────────────
// CONFLUENCE SCORING  (6 layers)
// ─────────────────────────────────────────────
longS1 = (ema5 > ema9 and ema9 > ema21 and close > ema21) ? 1 : 0
longS2 = (close > vwap) ? 1 : 0
longS3 = (rsi > 45 and rsi < rsiOB) ? 1 : 0
longS4 = (macdLine > sigLine or macdBull) ? 1 : 0
longS5 = (stK > stD and stK < 80) ? 1 : 0
longS6 = bullPattern ? 1 : 0
longScore = longS1 + longS2 + longS3 + longS4 + longS5 + longS6

shortS1 = (ema5 < ema9 and ema9 < ema21 and close < ema21) ? 1 : 0
shortS2 = (close < vwap) ? 1 : 0
shortS3 = (rsi < 55 and rsi > rsiOS) ? 1 : 0
shortS4 = (macdLine < sigLine or macdBear) ? 1 : 0
shortS5 = (stK < stD and stK > 20) ? 1 : 0
shortS6 = bearPattern ? 1 : 0
shortScore = shortS1 + shortS2 + shortS3 + shortS4 + shortS5 + shortS6

// ─────────────────────────────────────────────
// SIGNALS  (fire once per new trigger)
// ─────────────────────────────────────────────
longSignal  = longScore  >= minConf and volOk and inSession
             and not (longScore[1]  >= minConf and volOk[1])
shortSignal = shortScore >= minConf and volOk and inSession
             and not (shortScore[1] >= minConf and volOk[1])

// ─────────────────────────────────────────────
// TP / SL  — locked to entry bar price
// ─────────────────────────────────────────────
var float lEntry = na
var float lSL    = na
var float lTP1   = na
var float lTP2   = na
var float lTP3   = na
var float sEntry = na
var float sSL    = na
var float sTP1   = na
var float sTP2   = na
var float sTP3   = na
var int   lBar   = na   // bar_index when signal fired
var int   sBar   = na
var string lastDir = "NONE"

if longSignal
    lEntry := close
    lSL    := close - atr * slMult
    lTP1   := close + atr * tp1Mult
    lTP2   := close + atr * tp2Mult
    lTP3   := close + atr * tp3Mult
    lBar   := bar_index
    lastDir := "LONG"

if shortSignal
    sEntry := close
    sSL    := close + atr * slMult
    sTP1   := close - atr * tp1Mult
    sTP2   := close - atr * tp2Mult
    sTP3   := close - atr * tp3Mult
    sBar   := bar_index
    lastDir := "SHORT"

// ─────────────────────────────────────────────
// HOLD TIME ESTIMATE
// Assumes price moves ~0.45 ATR per bar on average intraday.
// hold_mins = bars_needed × timeframe_minutes
// ─────────────────────────────────────────────
tf_mins     = timeframe.in_seconds / 60.0
bars_per_atr = 2.2
holdTP1 = math.round(tp1Mult * bars_per_atr * tf_mins)
holdTP2 = math.round(tp2Mult * bars_per_atr * tf_mins)
holdTP3 = math.round(tp3Mult * bars_per_atr * tf_mins)

holdStr(mins) =>
    mins < 60 ? str.tostring(mins) + " min" : str.tostring(math.round(mins / 60.0, 1)) + " hr"

// ─────────────────────────────────────────────
// R:R helper
// ─────────────────────────────────────────────
rrStr(tp, sl, entry) =>
    str.tostring(math.round(math.abs(tp - entry) / math.abs(entry - sl), 1)) + ":1"

// ─────────────────────────────────────────────
// SCORE BAR  (filled █ blocks)
// ─────────────────────────────────────────────
scoreBar(s, maxS) =>
    filled = math.round(s)
    empty  = maxS - filled
    bar    = ""
    for i = 0 to filled - 1
        bar += "█"
    for i = 0 to empty - 1
        bar += "░"
    bar

// ─────────────────────────────────────────────
// EMAs & VWAP PLOTS
// ─────────────────────────────────────────────
plot(showEMAs ? ema5  : na, "EMA 5",  color=color.new(color.aqua,   0), linewidth=1)
plot(showEMAs ? ema9  : na, "EMA 9",  color=color.new(color.yellow, 0), linewidth=1)
plot(showEMAs ? ema21 : na, "EMA 21", color=color.new(color.orange, 0), linewidth=2)
plot(showEMAs ? ema50 : na, "EMA 50", color=color.new(color.gray,  40), linewidth=2)
plot(showVWAP ? vwap  : na, "VWAP",   color=color.new(color.purple, 0), linewidth=2)

// ─────────────────────────────────────────────
// SMALL SIGNAL DOTS on chart (not cluttered)
// ─────────────────────────────────────────────
plotshape(showDots and longSignal,
 style=shape.circle, location=location.belowbar,
 color=color.new(color.lime, 0), size=size.tiny, title="Long dot")

plotshape(showDots and shortSignal,
 style=shape.circle, location=location.abovebar,
 color=color.new(color.red, 0), size=size.tiny, title="Short dot")

// Subtle bar colour on signal bar only
barcolor(longSignal  ? color.new(color.lime, 60) : shortSignal ? color.new(color.red, 60) : na)

// ─────────────────────────────────────────────
// TP / SL LINES  (drawn from signal bar)
// ─────────────────────────────────────────────
ext = 40

if showTP and longSignal
    line.new(bar_index, lSL,  bar_index + ext, lSL,  color=color.new(color.red,   20), width=1, style=line.style_dotted)
    line.new(bar_index, lTP1, bar_index + ext, lTP1, color=color.new(color.lime,  40), width=1, style=line.style_dashed)
    line.new(bar_index, lTP2, bar_index + ext, lTP2, color=color.new(color.lime,  15), width=2, style=line.style_dashed)
    line.new(bar_index, lTP3, bar_index + ext, lTP3, color=color.new(color.lime,   0), width=2, style=line.style_solid)

if showTP and shortSignal
    line.new(bar_index, sSL,  bar_index + ext, sSL,  color=color.new(color.red,    20), width=1, style=line.style_dotted)
    line.new(bar_index, sTP1, bar_index + ext, sTP1, color=color.new(color.orange, 40), width=1, style=line.style_dashed)
    line.new(bar_index, sTP2, bar_index + ext, sTP2, color=color.new(color.orange, 15), width=2, style=line.style_dashed)
    line.new(bar_index, sTP3, bar_index + ext, sTP3, color=color.new(color.orange,  0), width=2, style=line.style_solid)

// ─────────────────────────────────────────────
// SIGNAL PANEL  (top-left, always visible)
// ─────────────────────────────────────────────
var table panel = table.new(position.top_left, 2, 18,
 bgcolor    = color.new(#0d0d0d, 10),
 border_color = color.new(color.gray, 60), border_width = 1,
 frame_color  = color.new(color.gray, 30), frame_width  = 2)

cell(col, row, txt, tc, sz, bg) =>
    table.cell(panel, col, row, txt,
     text_color=tc, text_size=sz,
     bgcolor=bg, text_halign=text.align_left)

if barstate.islast

    // ── Determine what to show (most recent signal) ──
    isLong  = lastDir == "LONG"
    isShort = lastDir == "SHORT"
    noSig   = lastDir == "NONE"

    dirColor  = isLong  ? color.lime :
                isShort ? color.red  : color.gray
    bgHeader  = isLong  ? color.new(#003300, 20) :
                isShort ? color.new(#330000, 20) : color.new(#1a1a1a, 20)

    dirText   = isLong  ? "▲  BUY  /  LONG" :
                isShort ? "▼  SELL  /  SHORT" : "◆  WAITING FOR SIGNAL"

    entryVal  = isLong  ? lEntry : isShort ? sEntry : close
    tp1Val    = isLong  ? lTP1   : isShort ? sTP1   : na
    tp2Val    = isLong  ? lTP2   : isShort ? sTP2   : na
    tp3Val    = isLong  ? lTP3   : isShort ? sTP3   : na
    slVal     = isLong  ? lSL    : isShort ? sSL    : na
    score     = isLong  ? longScore : isShort ? shortScore : 0
    barsAgo   = isLong  ? bar_index - lBar : isShort ? bar_index - sBar : 0
    minsAgo   = math.round(barsAgo * tf_mins)

    dp = syminfo.mintick >= 0.01 ? 2 : syminfo.mintick >= 0.0001 ? 4 : 5

    p(v) => str.tostring(math.round(v, dp))
    rr(tp, sl, en) => str.tostring(math.round(math.abs(tp - en) / math.abs(en - sl), 1)) + ":1"

    // Row 0 — Direction header
    table.cell(panel, 0, 0, dirText, text_color=dirColor,
     text_size=size.normal, bgcolor=bgHeader,
     text_halign=text.align_center)
    table.cell(panel, 1, 0, "", text_color=dirColor,
     text_size=size.normal, bgcolor=bgHeader)

    // Row 1 — Score bar
    cell(0, 1, "SCORE", color.silver, size.small, color.new(#111111, 0))
    cell(1, 1, scoreBar(score, 6) + "  " + str.tostring(score) + " / 6",
     score >= minConf ? color.lime : color.gray, size.small, color.new(#111111, 0))

    // Row 2 — Signal age
    cell(0, 2, "SIGNAL AGE", color.silver, size.small, color.new(#0d0d0d, 0))
    cell(1, 2, noSig ? "—" : str.tostring(barsAgo) + " bars  (~" + str.tostring(minsAgo) + " min ago)",
     color.white, size.small, color.new(#0d0d0d, 0))

    // Row 3 — Divider
    cell(0, 3, "─────────────", color.new(color.gray, 50), size.tiny, color.new(#0d0d0d, 0))
    cell(1, 3, "─────────────────────────", color.new(color.gray, 50), size.tiny, color.new(#0d0d0d, 0))

    // Row 4 — Entry
    cell(0, 4, "ENTRY", color.silver, size.small, color.new(#0d0d0d, 0))
    cell(1, 4, noSig ? "—" : p(entryVal), color.white, size.normal, color.new(#0d0d0d, 0))

    // Row 5 — SL
    cell(0, 5, "STOP LOSS", color.new(color.red, 20), size.small, color.new(#1a0000, 0))
    cell(1, 5, noSig ? "—" : p(slVal), color.new(color.red, 0), size.normal, color.new(#1a0000, 0))

    // Row 6 — Divider
    cell(0, 6, "─────────────", color.new(color.gray, 50), size.tiny, color.new(#0d0d0d, 0))
    cell(1, 6, "─────────────────────────", color.new(color.gray, 50), size.tiny, color.new(#0d0d0d, 0))

    // Row 7 — TP1
    tp1Color = isLong ? color.lime : color.new(color.orange, 0)
    cell(0, 7, "TP 1  (" + holdStr(holdTP1) + ")", color.silver, size.small, color.new(#001a00, 0))
    cell(1, 7, noSig ? "—" : p(tp1Val) + "   R:R " + rr(tp1Val, slVal, entryVal),
     tp1Color, size.normal, color.new(#001a00, 0))

    // Row 8 — TP2
    cell(0, 8, "TP 2  (" + holdStr(holdTP2) + ")", color.silver, size.small, color.new(#002200, 0))
    cell(1, 8, noSig ? "—" : p(tp2Val) + "   R:R " + rr(tp2Val, slVal, entryVal),
     tp1Color, size.normal, color.new(#002200, 0))

    // Row 9 — TP3
    cell(0, 9, "TP 3  (" + holdStr(holdTP3) + ")", color.silver, size.small, color.new(#003300, 0))
    cell(1, 9, noSig ? "—" : p(tp3Val) + "   R:R " + rr(tp3Val, slVal, entryVal),
     tp1Color, size.normal, color.new(#003300, 0))

    // Row 10 — Divider
    cell(0, 10, "─────────────", color.new(color.gray, 50), size.tiny, color.new(#0d0d0d, 0))
    cell(1, 10, "─────────────────────────", color.new(color.gray, 50), size.tiny, color.new(#0d0d0d, 0))

    // Row 11 — Header for live layer check
    cell(0, 11, "LIVE LAYERS", color.new(color.gray, 20), size.small, color.new(#111111, 0))
    cell(1, 11, "▲ LONG     ▼ SHORT", color.new(color.gray, 20), size.small, color.new(#111111, 0))

    chk(v)  => v ? "✔" : "✘"
    chkC(v) => v ? color.lime : color.new(color.red, 30)

    rowData(lv, sv, lbl) =>
        lc = chkC(lv == 1)
        sc = chkC(sv == 1)
        cell(0, 0, lbl, color.silver, size.tiny, color.new(#0d0d0d, 0))
        cell(1, 0, chk(lv == 1) + "           " + chk(sv == 1),
         lc, size.tiny, color.new(#0d0d0d, 0))

    // Rows 12-17 — Individual layers
    cell(0, 12, "EMA Stack",      color.silver, size.tiny, color.new(#0d0d0d, 0))
    cell(1, 12, chk(longS1==1) + "  Long   " + chk(shortS1==1) + "  Short",
     longS1==1 ? color.lime : color.new(color.red,30), size.tiny, color.new(#0d0d0d, 0))

    cell(0, 13, "VWAP Side",      color.silver, size.tiny, color.new(#0d0d0d, 0))
    cell(1, 13, chk(longS2==1) + "  Long   " + chk(shortS2==1) + "  Short",
     longS2==1 ? color.lime : color.new(color.red,30), size.tiny, color.new(#0d0d0d, 0))

    cell(0, 14, "RSI (" + str.tostring(math.round(rsi, 1)) + ")", color.silver, size.tiny, color.new(#0d0d0d, 0))
    cell(1, 14, chk(longS3==1) + "  Long   " + chk(shortS3==1) + "  Short",
     longS3==1 ? color.lime : color.new(color.red,30), size.tiny, color.new(#0d0d0d, 0))

    cell(0, 15, "MACD",           color.silver, size.tiny, color.new(#0d0d0d, 0))
    cell(1, 15, chk(longS4==1) + "  Long   " + chk(shortS4==1) + "  Short",
     longS4==1 ? color.lime : color.new(color.red,30), size.tiny, color.new(#0d0d0d, 0))

    cell(0, 16, "Stochastic",     color.silver, size.tiny, color.new(#0d0d0d, 0))
    cell(1, 16, chk(longS5==1) + "  Long   " + chk(shortS5==1) + "  Short",
     longS5==1 ? color.lime : color.new(color.red,30), size.tiny, color.new(#0d0d0d, 0))

    cell(0, 17, "Pattern/Burst",  color.silver, size.tiny, color.new(#0d0d0d, 0))
    cell(1, 17, chk(longS6==1) + "  Long   " + chk(shortS6==1) + "  Short",
     longS6==1 ? color.lime : color.new(color.red,30), size.tiny, color.new(#0d0d0d, 0))

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────
alertcondition(longSignal,  "▲ LONG Entry",  "LONG entry on {{ticker}} ({{interval}}). Check panel for TP/SL.")
alertcondition(shortSignal, "▼ SHORT Entry", "SHORT entry on {{ticker}} ({{interval}}). Check panel for TP/SL.")
